# SPEC-0008 — Caddy na frente da aplicação (ADR-0004), no Compose gerado pelo `aspire publish`.
# SPEC-0010 — HTTPS com HSTS. Local: https://localhost:8443 com o certificado da CA interna do Caddy (`tls internal`,
# não confiável fora da máquina); http://localhost:8080 responde 308 para o HTTPS. Na VPS (go-live), SITE_ADDRESS =
# domínio, HTTP_PORT/HTTPS_PORT = 80/443 e TLS_ISSUER = e-mail do ACME (certificado público). API_UPSTREAM e
# WEB_UPSTREAM (host:porta dos serviços) vêm do AppHost.
{
	http_port {$HTTP_PORT:8080}
	https_port {$HTTPS_PORT:8443}
	# A CA interna fica só no contêiner: nada é instalado no sistema.
	skip_install_trust
}

{$SITE_ADDRESS:localhost} {
	tls {$TLS_ISSUER:internal}
	encode zstd gzip

	# Só HTTPS por um ano (o HTTP já redireciona com 308).
	header Strict-Transport-Security "max-age=31536000"

	# API .NET: rotas /api/* e o health check da aplicação.
	@api path /api/* /health
	handle @api {
		reverse_proxy {$API_UPSTREAM}
	}

	# Front Next.js: todo o resto.
	handle {
		reverse_proxy {$WEB_UPSTREAM}
	}
}
