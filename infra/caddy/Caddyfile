# SPEC-0008 — Caddy na frente da aplicação (ADR-0004), no Compose gerado pelo `aspire publish`.
# SPEC-0010 — HTTPS com HSTS. Local: https://localhost:8443 com o certificado da CA interna do Caddy (`tls internal`,
# não confiável fora da máquina); http://localhost:8080 responde 308 para o HTTPS. Na VPS (go-live), SITE_ADDRESS =
# domínio, HTTP_PORT = 80 e TLS_ISSUER = e-mail do ACME (certificado público). API_UPSTREAM e WEB_UPSTREAM (host:porta
# dos serviços) vêm do AppHost.
# SPEC-0022 — /media/* (flyers, ADR-0015) sai do volume `media`, montado em /srv/media (o mesmo que a API grava em
# Media__Root): o nome é o hash do conteúdo, então o cache é imutável; nosniff para o navegador nunca adivinhar o tipo.
# A porta HTTPS local fica no endereço do site, não em `https_port`: o redirecionamento automático do Caddy omite a
# porta quando ela é igual ao `https_port` (iria para https://localhost/, a 443) e a inclui quando é outra.
{
	http_port {$HTTP_PORT:8080}
	# A CA interna fica só no contêiner: nada é instalado no sistema.
	skip_install_trust
}

{$SITE_ADDRESS:localhost:8443} {
	tls {$TLS_ISSUER:internal}
	encode zstd gzip

	# Só HTTPS por um ano (o HTTP já redireciona com 308).
	header Strict-Transport-Security "max-age=31536000"

	# API .NET: rotas /api/* e o health check da aplicação.
	@api path /api/* /health
	handle @api {
		reverse_proxy {$API_UPSTREAM}
	}

	# Mídia: arquivos estáticos do volume (handle_path tira o /media do caminho).
	# SPEC-0023 (H22-02): o cache imutável só vale para a resposta 200 (um 404 não pode ficar um ano em cache), e os
	# arquivos com ponto no nome (os temporários de uma gravação em andamento) nunca são servidos.
	handle_path /media/* {
		root * /srv/media
		header X-Content-Type-Options nosniff
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match {
				status 200
			}
		}
		file_server {
			hide .*
		}
	}

	# Front Next.js: todo o resto.
	handle {
		reverse_proxy {$WEB_UPSTREAM}
	}
}
