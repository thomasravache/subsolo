{
  "$comment": "SPEC-0009 (ADR-0010) — configuração do Seq como código: retenção, sinais salvos e alertas por e-mail, cada um com o seu runbook. Aplicada pelo AppHost (src/Subsolo.AppHost/SeqConfiguration.cs) quando o Seq local fica pronto; o e-mail sai pelo Mailpit. O Seq de produção e o destinatário real entram no go-live (SPEC-0003).",
  "retentionDays": 30,
  "email": {
    "app": { "packageId": "Seq.App.EmailPlus", "version": "5.0.0" },
    "from": "alertas@subsolo.local",
    "to": "responsavel@subsolo.local"
  },
  "alerts": [
    {
      "title": "Erros 5xx",
      "filter": "@Resource.service.name = 'api' and @SpanKind = 'Server' and http.response.status_code >= 500",
      "window": "00:05:00",
      "having": "count > 5",
      "runbook": "https://github.com/thomasravache/subsolo/blob/main/docs/runbooks/erros-5xx.md"
    },
    {
      "title": "Falha de job",
      "filter": "event.name = 'OutboxProcessingFailed' or event.name = 'NoticeDeliveriesRunFailed' or event.name = 'DailyDigestRunFailed' or event.name = 'NoticesRetentionRunFailed' or event.name = 'DayBeforeReminderRunFailed'",
      "window": "00:10:00",
      "having": "count >= 3",
      "runbook": "https://github.com/thomasravache/subsolo/blob/main/docs/runbooks/outbox-parada.md"
    },
    {
      "title": "Falha no envio do link",
      "filter": "event.name = 'MagicLinkSendFailed'",
      "window": "00:10:00",
      "having": "count > 5",
      "runbook": "https://github.com/thomasravache/subsolo/blob/main/docs/runbooks/link-magico-sem-envio.md"
    },
    {
      "title": "Falha no envio de aviso",
      "filter": "event.name = 'NoticeDeliveryFailed'",
      "window": "01:00:00",
      "having": "count > 20",
      "runbook": "https://github.com/thomasravache/subsolo/blob/main/docs/runbooks/avisos-sem-envio.md"
    },
    {
      "title": "Resumo diário falhou",
      "filter": "event.name = 'DailyDigestRunFailed' or event.name = 'NoticesRetentionRunFailed' or event.name = 'DayBeforeReminderRunFailed'",
      "window": "01:00:00",
      "having": "count >= 1",
      "runbook": "https://github.com/thomasravache/subsolo/blob/main/docs/runbooks/outbox-parada.md"
    }
  ]
}
