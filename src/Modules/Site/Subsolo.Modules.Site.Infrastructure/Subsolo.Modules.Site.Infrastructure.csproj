<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0028 — infraestrutura do módulo Site (ADR-0001, ADR-0002): DbContext do schema `site`, migrações e o registro
    do módulo (AddSiteModule).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Subsolo.Modules.Site.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só para gerar as migrações com `dotnet ef` (não vai para quem referencia o projeto). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Common/Subsolo.Common.Infrastructure/Subsolo.Common.Infrastructure.csproj" />
    <ProjectReference Include="../Subsolo.Modules.Site.Application/Subsolo.Modules.Site.Application.csproj" />
    <ProjectReference Include="../Subsolo.Modules.Site.Presentation/Subsolo.Modules.Site.Presentation.csproj" />
    <ProjectReference Include="../Subsolo.Modules.Site.IntegrationEvents/Subsolo.Modules.Site.IntegrationEvents.csproj" />
  </ItemGroup>

</Project>
