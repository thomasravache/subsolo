<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPEC-0014 — endpoints Minimal API do módulo Users (ADR-0001): GET /api/v1/me e POST /api/v1/auth/logout. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Subsolo.Modules.Users.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- O registro do módulo (Infrastructure) instancia o emissor do cookie de sessão. -->
    <InternalsVisibleTo Include="Subsolo.Modules.Users.Infrastructure" />
    <!-- SPEC-0021 (§7.6, herança da revisão da SPEC-0020): teste unitário das opções OIDC do Google. -->
    <InternalsVisibleTo Include="Subsolo.Users.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SPEC-0020: esquema OIDC `google` (Entrar com Google; ADR-0003). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Common/Subsolo.Common.Presentation/Subsolo.Common.Presentation.csproj" />
    <ProjectReference Include="../Subsolo.Modules.Users.Application/Subsolo.Modules.Users.Application.csproj" />
  </ItemGroup>

</Project>
