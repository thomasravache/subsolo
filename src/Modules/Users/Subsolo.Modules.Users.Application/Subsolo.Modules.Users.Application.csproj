<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0014 — casos de uso do módulo Users (ADR-0001): entrada (ISignInService, usado pelos slices de login) e
    validação da sessão (ISessionValidator, exposto no IntegrationEvents), um por pasta em Features/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Subsolo.Modules.Users.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- O registro do módulo (Infrastructure) instancia os serviços internos. -->
    <InternalsVisibleTo Include="Subsolo.Modules.Users.Infrastructure" />
    <!-- SPEC-0020: o handler OIDC (Presentation) entrega o retorno do Google ao GoogleSignInCallback. -->
    <InternalsVisibleTo Include="Subsolo.Modules.Users.Presentation" />
    <InternalsVisibleTo Include="Subsolo.Users.UnitTests" />
    <InternalsVisibleTo Include="Subsolo.Users.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Common/Subsolo.Common.Application/Subsolo.Common.Application.csproj" />
    <ProjectReference Include="../Subsolo.Modules.Users.Domain/Subsolo.Modules.Users.Domain.csproj" />
    <ProjectReference Include="../Subsolo.Modules.Users.IntegrationEvents/Subsolo.Modules.Users.IntegrationEvents.csproj" />
    <!-- SPEC-0016: o link mágico sai pela API pública do Notifications (SPEC-0018@1, ADR-0014). -->
    <ProjectReference Include="../../Notifications/Subsolo.Modules.Notifications.IntegrationEvents/Subsolo.Modules.Notifications.IntegrationEvents.csproj" />
  </ItemGroup>

</Project>
