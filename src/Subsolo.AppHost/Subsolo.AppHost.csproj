<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <!--
    SPEC-0007 — AppHost do Aspire 13.6 (ADR-0004): `aspire run` sobe localmente PostgreSQL 18, Seq, Mailpit, a API
    e o front (web/, pnpm).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Subsolo.AppHost</RootNamespace>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>subsolo-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Seq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Subsolo.Api/Subsolo.Api.csproj" />
  </ItemGroup>

</Project>
