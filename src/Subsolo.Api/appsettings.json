{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Quartz": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Users": {
    "AdminEmails": []
  },
  "Engagement": {
    "DigestCron": "0 0 9 * * ?",
    "DigestCatchUpCron": "0 0/15 * * * ?",
    "ReminderCron": "0 0 * * * ?",
    "ReminderHour": 10
  }
}
