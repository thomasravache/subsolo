<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SPEC-0007 — host único da API (ADR-0001): compõe os módulos (services.Add<M>Module / endpoints), publica o
    OpenAPI em /openapi/v1.json e os health checks; em Development aplica as migrações no start.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Subsolo.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!--
      SPEC-0022 (ADR-0015): só para a publicação levar o NetVips e o libvips nativo, que o Common.Infrastructure usa
      (lá a referência é privada). Nenhum tipo do host usa o NetVips (teste de arquitetura).
    -->
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Common/Subsolo.Common.Infrastructure/Subsolo.Common.Infrastructure.csproj" />
    <ProjectReference Include="../Common/Subsolo.Common.Presentation/Subsolo.Common.Presentation.csproj" />
    <ProjectReference Include="../Modules/Events/Subsolo.Modules.Events.Infrastructure/Subsolo.Modules.Events.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/Notifications/Subsolo.Modules.Notifications.Infrastructure/Subsolo.Modules.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/Profiles/Subsolo.Modules.Profiles.Infrastructure/Subsolo.Modules.Profiles.Infrastructure.csproj" />
    <ProjectReference Include="../Modules/Users/Subsolo.Modules.Users.Infrastructure/Subsolo.Modules.Users.Infrastructure.csproj" />
    <ProjectReference Include="../Subsolo.ServiceDefaults/Subsolo.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
