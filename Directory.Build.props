<Project>

  <!--
    Regras de build comuns a todos os projetos .NET do repositório (ADR-0006, ADR-0009).
    Autossuficiente de propósito: não importa nenhum Directory.Build.props acima da raiz.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' and '$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
  </PropertyGroup>

</Project>
