<Project>

  <!--
    Central Package Management (ADR-0009): a versão de cada pacote NuGet é declarada aqui, uma única vez.
    Os projetos usam <PackageReference Include="..." /> sem Version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Produção (SPEC-0007): blocos Common, Api, ServiceDefaults e AppHost (ADR-0001, ADR-0002, ADR-0004, ADR-0010). -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Seq" Version="13.6.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!-- SPEC-0020 (ADR-0003): login com Google por OpenID Connect (handler oficial; mesma versão do ASP.NET Core). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <!-- SPEC-0018 (ADR-0014): e-mail por SMTP no módulo Notifications (4.18.1, publicado em 2026-09-27; traz o MimeKit). -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- SPEC-0030 (ADR-0014, ADR-0009): canal Web Push (VAPID direto, aes128gcm) no módulo Notifications.
         Lib.Net.Http.WebPush 3.3.1 (MIT, publicado em 2025-03-09; traz o Lib.Net.Http.EncryptedContentEncoding 2.1.1,
         MIT, sem dependências no net10.0), verificados em nuget.org em 2026-10-23. -->
    <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <!-- Transitivo do Aspire.Hosting 13.6.1 (2.5.302): fixado acima de GHSA-qhrr-8q5h-9q3h (corrigido em 2.5.303). -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- SPEC-0022 (ADR-0015): processamento dos flyers com libvips (NetVips MIT; libvips LGPL ligada dinamicamente).
         NetVips 3.2.0 e NetVips.Native 8.18.7 (2026-09-28), verificados em nuget.org em 2026-10-18. Os testes de
         integração também usam o NetVips para gerar as imagens de teste e ler as variantes. -->
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <PackageVersion Include="NetVips.Native" Version="8.18.7" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="Quartz" Version="4.5.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <!-- Transitivo do MimeKit 4.18.1 (10.0.0): fixado acima de GHSA-846f-f764-76mx e GHSA-2fmv-rv2c-59x7 (corrigidos em 10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Testes. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- SPEC-0009: exportador em memória do OpenTelemetry (logs e spans exportados nos testes de observabilidade). -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
