{
  "name": "subsolo-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "api:generate": "openapi-typescript ../docs/api/openapi.v1.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "api:check": "openapi-typescript ../docs/api/openapi.v1.json | prettier --stdin-filepath src/api/schema.d.ts | diff -u src/api/schema.d.ts - && echo 'api:check: src/api/schema.d.ts em dia com ../docs/api/openapi.v1.json'",
    "lint": "pnpm run lint:eslint; e1=$?; pnpm run lint:format; e2=$?; pnpm run lint:types; e3=$?; exit $((e1 || e2 || e3))",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:format": "prettier --check .",
    "lint:types": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@vercel/otel": "2.1.3",
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
