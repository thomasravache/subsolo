{
  "openapi": "3.1.1",
  "info": {
    "title": "Subsolo.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/cities/{slug}/agenda": {
      "get": {
        "tags": [
          "Agenda"
        ],
        "summary": "Agenda da cidade",
        "description": "Cidade e shows entre from e to (padrão: de hoje, no fuso da cidade, até +60 dias; máximo 180 dias).",
        "operationId": "GetCityAgenda",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityAgendaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CityAgendaResponse": {
        "required": [
          "city",
          "shows"
        ],
        "type": "object",
        "properties": {
          "city": {
            "$ref": "#/components/schemas/CityResponse"
          },
          "shows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShowSummaryResponse"
            }
          }
        }
      },
      "CityResponse": {
        "required": [
          "slug",
          "name",
          "state",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ShowSummaryResponse": {
        "required": [
          "id",
          "slug",
          "title",
          "startsAt",
          "venueName",
          "lineup",
          "styles",
          "status",
          "flyerThumbUrl",
          "attendingCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "venueName": {
            "type": "string"
          },
          "lineup": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "styles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "flyerThumbUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "attendingCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Agenda"
    }
  ]
}
