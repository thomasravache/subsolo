<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0005 — base dos testes unitários .NET (ADR-0005): asserções com Shouldly e tempo controlado com
    FakeTimeProvider (Microsoft.Extensions.Time.Testing). Os projetos de teste referenciam este projeto.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Subsolo.UnitTests.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

</Project>
