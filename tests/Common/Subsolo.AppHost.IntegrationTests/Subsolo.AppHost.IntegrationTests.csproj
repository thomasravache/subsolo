<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0007 IT-07 — o Subsolo.AppHost sobe com Aspire.Hosting.Testing (DistributedApplicationTestingBuilder):
    api e web saudáveis e GET /health da API com 200. Usa Docker, Node.js e pnpm.
    Projeto separado do Subsolo.Api.IntegrationTests porque AppHost e API têm, cada um, o seu Program.
    SPEC-0008 IT-05 — o Compose gerado por `aspire publish` (Aspire CLI) tem a API em Production por padrão e
    nenhum dashboard do Aspire.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Subsolo.AppHost.IntegrationTests</RootNamespace>
    <!--
      Com `dotnet test Subsolo.slnx` e filtro (comandos do sdd-config), um projeto sem nenhum teste no filtro
      termina com o código 8 do Microsoft.Testing.Platform ("zero testes"); isso não é falha.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Subsolo.UnitTests.Common/Subsolo.UnitTests.Common.csproj" />
    <ProjectReference Include="../../../src/Subsolo.AppHost/Subsolo.AppHost.csproj" />
  </ItemGroup>

</Project>
