<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0007 — dublê de teste: módulo de exemplo "TemplateB" (schema `template_b`), que consome o evento de
    integração do Template pela inbox. Só referencia o contrato público do Template (ADR-0001). Não é código de
    produção.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Subsolo.Modules.TemplateB</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só para gerar as migrações com `dotnet ef` (não vai para quem referencia o projeto). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/Common/Subsolo.Common.Infrastructure/Subsolo.Common.Infrastructure.csproj" />
    <ProjectReference Include="../Subsolo.Modules.Template.IntegrationEvents/Subsolo.Modules.Template.IntegrationEvents.csproj" />
  </ItemGroup>

</Project>
