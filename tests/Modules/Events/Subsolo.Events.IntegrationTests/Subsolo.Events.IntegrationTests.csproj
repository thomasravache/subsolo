<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0008 — testes de integração do módulo Events (IT-01..IT-03): GET /api/v1/cities/{slug}/agenda no
    Subsolo.Api em memória (WebApplicationFactory) com PostgreSQL real (PostgresFixture).
    SPEC-0022 — upload e processamento de flyer (IT-01..IT-07) com o NetVips real e um diretório temporário como Media:Root.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Subsolo.Events.IntegrationTests</RootNamespace>
    <!--
      Com `dotnet test Subsolo.slnx` e filtro (comandos do sdd-config), um projeto sem nenhum teste no filtro
      termina com o código 8 do Microsoft.Testing.Platform ("zero testes"); isso não é falha.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- SPEC-0022: gera as imagens de teste (com EXIF e GPS sintéticos) e lê as medidas das variantes (ADR-0015). -->
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
  </ItemGroup>

  <ItemGroup>
    <!-- A definição da coleção precisa estar no assembly de teste (regra do xUnit). -->
    <Compile Include="../../../Subsolo.IntegrationTests.Common/PostgresCollection.cs" Link="PostgresCollection.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Subsolo.IntegrationTests.Common/Subsolo.IntegrationTests.Common.csproj" />
    <ProjectReference Include="../../../../src/Subsolo.Api/Subsolo.Api.csproj" />
  </ItemGroup>

</Project>
