<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPEC-0028 — testes unitários do módulo Site (UT-02): o validador do apoiador (nome de 2 a 60, link https opcional). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Subsolo.Site.UnitTests</RootNamespace>
    <!--
      Com `dotnet test Subsolo.slnx` e filtro (comandos do sdd-config), um projeto sem nenhum teste no filtro
      termina com o código 8 do Microsoft.Testing.Platform ("zero testes"); isso não é falha.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Subsolo.UnitTests.Common/Subsolo.UnitTests.Common.csproj" />
    <ProjectReference Include="../../../../src/Modules/Site/Subsolo.Modules.Site.Application/Subsolo.Modules.Site.Application.csproj" />
  </ItemGroup>

</Project>
