<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0005 — testes de arquitetura (ADR-0005, ADR-0001) com ArchUnitNET e o helper ArchitectureRules, que
    declara as regras por módulo (consumido pela SPEC-0007). Comando `arch_test` do sdd-config.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Subsolo.ArchitectureTests</RootNamespace>
    <!--
      Com `dotnet test Subsolo.slnx` e filtro (comandos do sdd-config), um projeto sem nenhum teste no filtro
      termina com o código 8 do Microsoft.Testing.Platform ("zero testes"); isso não é falha.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <!-- SPEC-0018 IT-05: dublê que usa o MailKit fora do Notifications (violação proposital da regra do ADR-0014). -->
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Subsolo.UnitTests.Common/Subsolo.UnitTests.Common.csproj" />
    <!-- SPEC-0005 IT-05: assembly de exemplo com uma violação proposital do ADR-0001. -->
    <ProjectReference Include="../Examples/Subsolo.Examples.ArchitectureSamples/Subsolo.Examples.ArchitectureSamples.csproj" />
    <!--
      SPEC-0007 IT-06: as regras do ADR-0001 valem para todo assembly Subsolo.Modules.* ao lado deste projeto.
      Cada módulo real é referenciado aqui; os módulos de exemplo Template/TemplateB existem só nos testes.
    -->
    <ProjectReference Include="../Common/Modules/Subsolo.Modules.Template/Subsolo.Modules.Template.csproj" />
    <ProjectReference Include="../Common/Modules/Subsolo.Modules.Template.IntegrationEvents/Subsolo.Modules.Template.IntegrationEvents.csproj" />
    <ProjectReference Include="../Common/Modules/Subsolo.Modules.TemplateB/Subsolo.Modules.TemplateB.csproj" />
    <!-- SPEC-0008: módulo Events (primeiro módulo real). -->
    <ProjectReference Include="../../src/Modules/Events/Subsolo.Modules.Events.Application/Subsolo.Modules.Events.Application.csproj" />
    <ProjectReference Include="../../src/Modules/Events/Subsolo.Modules.Events.Domain/Subsolo.Modules.Events.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Events/Subsolo.Modules.Events.Infrastructure/Subsolo.Modules.Events.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Modules/Events/Subsolo.Modules.Events.IntegrationEvents/Subsolo.Modules.Events.IntegrationEvents.csproj" />
    <ProjectReference Include="../../src/Modules/Events/Subsolo.Modules.Events.Presentation/Subsolo.Modules.Events.Presentation.csproj" />
    <!-- SPEC-0014: módulo Users. -->
    <ProjectReference Include="../../src/Modules/Users/Subsolo.Modules.Users.Application/Subsolo.Modules.Users.Application.csproj" />
    <ProjectReference Include="../../src/Modules/Users/Subsolo.Modules.Users.Domain/Subsolo.Modules.Users.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Users/Subsolo.Modules.Users.Infrastructure/Subsolo.Modules.Users.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Modules/Users/Subsolo.Modules.Users.IntegrationEvents/Subsolo.Modules.Users.IntegrationEvents.csproj" />
    <ProjectReference Include="../../src/Modules/Users/Subsolo.Modules.Users.Presentation/Subsolo.Modules.Users.Presentation.csproj" />
    <!-- SPEC-0018: módulo Notifications. -->
    <ProjectReference Include="../../src/Modules/Notifications/Subsolo.Modules.Notifications.Application/Subsolo.Modules.Notifications.Application.csproj" />
    <ProjectReference Include="../../src/Modules/Notifications/Subsolo.Modules.Notifications.Domain/Subsolo.Modules.Notifications.Domain.csproj" />
    <ProjectReference Include="../../src/Modules/Notifications/Subsolo.Modules.Notifications.Infrastructure/Subsolo.Modules.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Modules/Notifications/Subsolo.Modules.Notifications.IntegrationEvents/Subsolo.Modules.Notifications.IntegrationEvents.csproj" />
    <ProjectReference Include="../../src/Modules/Notifications/Subsolo.Modules.Notifications.Presentation/Subsolo.Modules.Notifications.Presentation.csproj" />
    <!-- SPEC-0007 IT-06: assembly de exemplo com uma violação de cada regra do ADR-0001. -->
    <ProjectReference Include="../Common/Subsolo.Common.ArchitectureViolations/Subsolo.Common.ArchitectureViolations.csproj" />
  </ItemGroup>

</Project>
