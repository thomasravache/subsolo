<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPEC-0010 — testes de integração da segurança base no Subsolo.Api em memória (WebApplicationFactory) com
    PostgreSQL real (PostgresFixture): endpoints do host com autorização declarada (IT-01), 401/403 das políticas
    (IT-02), rate limiting (IT-03), anti-forgery (IT-04) e a agenda pública sob a política de fallback (CT-01).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Subsolo.Security.IntegrationTests</RootNamespace>
    <!--
      Com `dotnet test Subsolo.slnx` e filtro (comandos do sdd-config), um projeto sem nenhum teste no filtro
      termina com o código 8 do Microsoft.Testing.Platform ("zero testes"); isso não é falha.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- A definição da coleção precisa estar no assembly de teste (regra do xUnit). -->
    <Compile Include="../../Subsolo.IntegrationTests.Common/PostgresCollection.cs" Link="PostgresCollection.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Subsolo.IntegrationTests.Common/Subsolo.IntegrationTests.Common.csproj" />
    <ProjectReference Include="../../../src/Subsolo.Api/Subsolo.Api.csproj" />
  </ItemGroup>

</Project>
